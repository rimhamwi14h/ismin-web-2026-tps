// The schema is the source of truth: it describes the database AND the
// TypeScript types. The two cannot drift apart.

datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

